# --- LLM (any OpenAI-compatible endpoint; Groq by default) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Supabase (optional locally; required on Render because its disk is ephemeral) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# --- Server ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=40

# gpt-oss reasoning depth (low keeps a full case inside Groq free-tier 8k tokens/min)
LLM_REASONING_EFFORT=low
